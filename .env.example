# Server-side environment variables
PORT=3000

# Optional Gemma / Open-Weight AI model inference endpoint (vLLM, Ollama, HuggingFace, or OpenRouter)
# e.g. http://localhost:11434/api/generate or https://api-inference.huggingface.co/models/google/gemma-2-9b-it
GEMMA_API_ENDPOINT=
GEMMA_API_KEY=
GEMMA_MODEL_ID=google/gemma-2-9b-it

# Optional Google AI Studio API key (used if Gemma via Gemini SDK is enabled)
GEMINI_API_KEY=
